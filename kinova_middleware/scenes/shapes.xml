<!-- Scene 03: Mixed Shapes
     Red cylinder, blue box, and green sphere – reproduces original layout. -->
<mujoco model="scene_shapes">
  <compiler meshdir="../../kinova_description/meshes/" angle="radian" balanceinertia="true"/>
  <include file="../../kinova_description/mjcf/m1n4s300_standalone.mjcf"/>

  <worldbody>
    <!-- Red cylinder – lying on its side -->
    <body name="red_cylinder" pos="0.15 -0.35 0.031" quat="0.70710678 0 0.70710678 0">
      <freejoint name="can_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.0000167 0.0000167 0.00001"/>
      <geom name="can_geom"
            type="cylinder" size="0.03 0.09"
            material="red_cube"
            contype="1" conaffinity="1" friction="0.8 0.01 0.001" solref="0.005 1" margin="0.002" condim="3"/>
    </body>

    <!-- Blue box -->
    <body name="box" pos="-0.2 -0.2 0.03" quat="1 0 0 0">
      <freejoint name="box_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
      <geom name="box_geom"
            type="box" size="0.03 0.03 0.03"
            material="blue_box"
            contype="1" conaffinity="1" friction="0.8 0.01 0.001" solref="0.005 1" margin="0.002" condim="3"/>
    </body>

    <!-- Green sphere -->
    <body name="sphere" pos="-0.15 0.35 0.03" quat="1 0 0 0">
      <freejoint name="sphere_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
      <geom name="sphere_geom"
            type="sphere" size="0.04"
            material="green_sphere"
            contype="1" conaffinity="1" friction="0.8 0.01 0.001" solref="0.005 1" margin="0.002" condim="3"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- qpos: 10 robot, 7 cylinder, 7 box, 7 sphere = 31 -->
    <key name="home"
      qpos="1.48353 3.22886 4.90438 0  0 0  0 0  0 0
            0.15 -0.20 0.031  0.70710678 0 0.70710678 0
            -0.2 -0.2 0.03  1 0 0 0
            -0.15 0.35 0.03  1 0 0 0"/>
  </keyframe>
</mujoco>
