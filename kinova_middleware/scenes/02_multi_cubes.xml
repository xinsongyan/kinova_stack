<!-- Scene 02: Multiple Cubes
     Three cubes at different positions for multi-object manipulation. -->
<mujoco model="scene_multi_cubes">
  <compiler meshdir="../../kinova_description/meshes/" angle="radian" balanceinertia="true"/>
  <include file="../../kinova_description/mjcf/m1n4s300_standalone.mjcf"/>

  <worldbody>
    <!-- Red cube – front right -->
    <body name="cube_1" pos="0.2 -0.2 0.03" quat="1 0 0 0">
      <freejoint name="cube_1_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
      <geom name="cube_1_geom"
            type="box" size="0.03 0.03 0.03"
            material="red_cube"
            contype="1" conaffinity="1" friction="1 0.02 0.001" margin="0.002" condim="3"/>
    </body>

    <!-- Blue cube – front left -->
    <body name="cube_2" pos="-0.2 -0.2 0.03" quat="1 0 0 0">
      <freejoint name="cube_2_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
      <geom name="cube_2_geom"
            type="box" size="0.03 0.03 0.03"
            material="blue_box"
            contype="1" conaffinity="1" friction="1 0.02 0.001" margin="0.002" condim="3"/>
    </body>

    <!-- Green cube – back centre -->
    <body name="cube_3" pos="0.0 0.25 0.03" quat="1 0 0 0">
      <freejoint name="cube_3_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
      <geom name="cube_3_geom"
            type="box" size="0.03 0.03 0.03"
            material="green_sphere"
            contype="1" conaffinity="1" friction="1 0.02 0.001" margin="0.002" condim="3"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- qpos: 10 robot, 7 cube_1, 7 cube_2, 7 cube_3 = 31 -->
    <key name="home"
      qpos="1.48353 3.22886 4.90438 0  0 0  0 0  0 0
            0.2 -0.2 0.03  1 0 0 0
            -0.2 -0.2 0.03  1 0 0 0
            0.0 0.25 0.03  1 0 0 0"/>
  </keyframe>
</mujoco>
