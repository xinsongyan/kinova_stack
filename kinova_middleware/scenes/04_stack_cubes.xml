<!-- Scene 04: Stack Cubes
     Three cubes stacked vertically for a stacking challenge. -->
<mujoco model="scene_stack_cubes">
  <compiler meshdir="../../kinova_description/meshes/" angle="radian" balanceinertia="true"/>
  <include file="../../kinova_description/mjcf/m1n4s300_standalone.mjcf"/>

  <worldbody>
    <!-- Bottom cube (red) -->
    <body name="cube_bottom" pos="0.2 -0.2 0.03" quat="1 0 0 0">
      <freejoint name="cube_bottom_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
      <geom name="cube_bottom_geom"
            type="box" size="0.03 0.03 0.03"
            material="red_cube"
            contype="1" conaffinity="1" friction="1 0.02 0.001" margin="0.002" condim="3"/>
    </body>

    <!-- Middle cube (blue) -->
    <body name="cube_middle" pos="0.2 -0.2 0.09" quat="1 0 0 0">
      <freejoint name="cube_middle_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
      <geom name="cube_middle_geom"
            type="box" size="0.03 0.03 0.03"
            material="blue_box"
            contype="1" conaffinity="1" friction="1 0.02 0.001" margin="0.002" condim="3"/>
    </body>

    <!-- Top cube (green) -->
    <body name="cube_top" pos="0.2 -0.2 0.15" quat="1 0 0 0">
      <freejoint name="cube_top_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
      <geom name="cube_top_geom"
            type="box" size="0.03 0.03 0.03"
            material="green_sphere"
            contype="1" conaffinity="1" friction="1 0.02 0.001" margin="0.002" condim="3"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- qpos: 10 robot, 7 bottom, 7 middle, 7 top = 31 -->
    <key name="home"
      qpos="1.48353 3.22886 4.90438 0  0 0  0 0  0 0
            0.2 -0.2 0.03  1 0 0 0
            0.2 -0.2 0.09  1 0 0 0
            0.2 -0.2 0.15  1 0 0 0"/>
  </keyframe>
</mujoco>
